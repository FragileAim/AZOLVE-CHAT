# ─────────────────────────────────────────────────────────────
#  AZOLVE CHAT — environment template
#  Copy to .env for local use. On Render, set these as env vars.
#  NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────

PORT=3000

# Long random string. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Where the SQLite database and uploads live.
# Local: ./data      Render: /var/data   (mount a persistent disk there)
DATA_DIR=./data

# ── Email OTP (PRIMARY channel) ───────────────────────────────────────────────
# SMS to Indian handsets requires DLT registration, so email is the default
# verification channel until that approval lands. Pick one provider:
#
#   console   free, prints the code to the server log (default, no signup)
#   resend    free 3,000/month, 100/day, no credit card   -> https://resend.com
#   brevo     free 300/day, no credit card                -> https://brevo.com
#   smtp      any mailbox you own (Gmail app password, Zoho, SES, Postfix)
#   sendgrid  free 100/day                                -> https://sendgrid.com
#   mailgun   needs a verified domain
#
# Leave EMAIL_PROVIDER blank to auto-detect from whichever key is present.
EMAIL_PROVIDER=
EMAIL_FROM=no-reply@azolve.io
EMAIL_FROM_NAME=AZOLVE CHAT
EMAIL_REPLY_TO=support@azolve.io

# Resend (recommended - free, no card)
RESEND_API_KEY=
# Brevo
BREVO_API_KEY=
# SendGrid
SENDGRID_API_KEY=
# Mailgun
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# Generic SMTP - Gmail needs an App Password, not your login password.
#   Gmail:     smtp.gmail.com  port 465  secure 1
#   Zoho:      smtp.zoho.in    port 465  secure 1
#   Amazon SES smtp.<region>.amazonaws.com  port 587
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Phone OTP ────────────────────────────────────────────────
# Which SMS gateway to use:
#   console   free, prints the code to the server log (default, no signup)
#   textbelt  free tier = 1 SMS/day, no account needed
#   fast2sms  India, free trial credits
#   msg91     India, free trial credits
#   2factor   India, free trial credits
#   vonage    trial credit, verified numbers only
#   twilio    trial credit, verified numbers only
SMS_PROVIDER=console

# Return the OTP in the API response so your team can log in while testing.
# 1 = echo the code to the browser (TESTING ONLY), 0 = never (production)
OTP_DEV_ECHO=0

# The first account created on an empty database becomes admin.
# Set to 0 to disable and promote admins manually.
FIRST_USER_IS_ADMIN=1

# Demo/sample workspace. Leave unset or 0 for a clean deployment.
# SEED_DEMO=1 recreates the old sample users, posts and groups.
SEED_DEMO=0

# ── SMS provider credentials (only fill the one you use) ─────
# textbelt (optional key for paid volume)
TEXTBELT_API_KEY=
# fast2sms
FAST2SMS_API_KEY=
# msg91 (flow-based template)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
# 2factor.in
TWOFACTOR_API_KEY=
# Vonage / Nexmo
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── Translation ──────────────────────────────────────────────
# Tried left to right; the first that answers wins. "offline" always works.
TRANSLATION_PROVIDER=deepl,google,libre,openai,mymemory,offline
DEEPL_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
LIBRE_TRANSLATE_URL=
LIBRE_TRANSLATE_KEY=
MYMEMORY_EMAIL=

# ── AI assistant / summaries ─────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional override. Leave blank: the server auto-tries gemini-3.6-flash → gemini-flash-latest
# → gemini-2.5-flash → gemini-1.5-flash and caches whichever answers.
GEMINI_MODEL=
GROQ_API_KEY=
OLLAMA_URL=

# ── Social sign-in (optional) ────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Voice & video calling (WebRTC)
# STUN alone is enough on the same Wi-Fi. For calls between mobile networks
# (CGNAT) or corporate firewalls you need a TURN relay. Free options:
#   - Metered Open Relay  https://www.metered.ca/tools/openrelay/  (free tier)
#   - self-hosted coturn  https://github.com/coturn/coturn
# Multiple URLs may be comma-separated.
# ---------------------------------------------------------------------------
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URL=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:443,turns:global.relay.metered.ca:443

# --- Option A: Metered (recommended) ---------------------------------------
# Metered gives you an API Key ID (sk_id_...) and a Signing secret (sk_secret_...)
# per app. Those are NOT a TURN username/password — the relay rejects them if
# used directly. Set TURN_APP to your sub-domain (the "yourapp" in
# yourapp.metered.live) and the server exchanges the keys for short-lived
# credentials, cached for 30 minutes.
TURN_APP=
TURN_API_KEY=
TURN_API_SECRET=

# --- Option B: self-hosted coturn with use-auth-secret ----------------------
# Same value as coturn's `static-auth-secret`. No API call needed.
TURN_STATIC_AUTH_SECRET=

# --- Option C: a static username/password -----------------------------------
# Simplest, but long-lived. Fine for a team test, not for production.
TURN_USERNAME=
TURN_CREDENTIAL=
# Optional: full ICE_SERVERS JSON array overrides the three vars above
# ICE_SERVERS=[{"urls":"turn:host:3478","username":"u","credential":"p"}]
# 'relay' forces all media through TURN (useful for debugging)
ICE_TRANSPORT_POLICY=all
# How long an unanswered call rings before it is marked missed (ms)
CALL_RING_TIMEOUT_MS=45000
