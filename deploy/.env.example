# =============================================================================
#  AZOLVE CHAT - deployment environment
#  Government of Dubai / sovereign on-premises profile
#
#  Run ./init.sh to create the real .env with generated secrets.
#  Never commit the real .env. Never reuse these values across environments.
# =============================================================================

# --- Core -------------------------------------------------------------------
PORT=3000
DATA_DIR=/data

# The address users will actually open. Used in emails, OAuth redirects and
# the Android App Link, so it must match the certificate exactly.
PUBLIC_BASE_URL=https://chat.example.gov.ae

# Generated by init.sh. 48 bytes of entropy.
JWT_SECRET=

# --- Snapshot store ---------------------------------------------------------
# SQLite is the live database; this is where the encrypted copy lives so a
# lost volume does not lose accounts. init.sh fills the URL in.
SNAPSHOT_KEY=
SNAPSHOT_PG_URL=
SNAPSHOT_EVERY=60

# --- Administration ---------------------------------------------------------
# The first account created becomes admin if FIRST_USER_IS_ADMIN=1.
FIRST_USER_IS_ADMIN=1
ADMIN_EMAILS=
ADMIN_PHONES=

# Absolutely leave this unset in production. It would put sample users in a
# government database.
SEED_DEMO=0

# Leave unset in production. Echoes OTP codes in API responses for testing.
OTP_DEV_ECHO=

# --- Email OTP (primary verification channel) -------------------------------
# smtp is the right choice on-premises: point it at the authority's relay.
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@chat.example.gov.ae
EMAIL_FROM_NAME=AZOLVE CHAT
EMAIL_REPLY_TO=support@chat.example.gov.ae

SMTP_HOST=mail.example.gov.ae
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@chat.example.gov.ae
# Set to 1 to require a valid certificate chain. Keep 1 in production.
SMTP_STRICT_TLS=1

# --- SMS OTP (secondary channel) --------------------------------------------
# console prints the code to the container log; use it only during acceptance
# testing. In production point this at the approved gateway.
SMS_PROVIDER=console

# --- Translation ------------------------------------------------------------
# For a sovereign deployment, prefer the self-hosted LibreTranslate instance
# started with --profile offline-ai. Nothing then leaves the jurisdiction.
#   TRANSLATION_PROVIDER=libre
#   LIBRE_TRANSLATE_URL=http://translate:5000
# Leave blank to auto-detect from whichever key is present.
TRANSLATION_PROVIDER=libre
LIBRE_TRANSLATE_URL=http://translate:5000
LIBRE_TRANSLATE_KEY=

# --- AI ---------------------------------------------------------------------
# With --profile offline-ai, point at the local Ollama. Otherwise set one of
# the hosted keys below and accept that content leaves the country.
OLLAMA_URL=http://ai:11434
OLLAMA_MODEL=llama3.1

# --- WebRTC -----------------------------------------------------------------
# coturn is started by docker compose. The app mints short-lived credentials
# from this shared secret, so it must match TURN_STATIC_AUTH_SECRET in .env.
TURN_URL=turn:chat.example.gov.ae:3478?transport=udp,turn:chat.example.gov.ae:3478?transport=tcp
TURN_STATIC_AUTH_SECRET=
TURN_REALM=azolve.gov.ae
TURN_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
# Only when the host is behind 1:1 NAT: the public address of the relay.
TURN_EXTERNAL_IP=

STUN_URLS=stun:stun.l.google.com:19302

# --- Push notifications -----------------------------------------------------
# Firebase is operated outside the UAE. For a government deployment, either
# obtain approval or leave push disabled and rely on in-app notifications.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@chat.example.gov.ae

# --- Single sign-on ---------------------------------------------------------
# Leave blank to hide the Google / Apple buttons entirely, which is the usual
# requirement for a government tenant.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=

# --- Compose tuning ---------------------------------------------------------
HTTP_PORT=80
HTTPS_PORT=443
APP_VERSION=1.1.14
APP_CPUS=2
APP_MEMORY=2g
POSTGRES_DB=azolve
POSTGRES_USER=azolve
POSTGRES_PASSWORD=
