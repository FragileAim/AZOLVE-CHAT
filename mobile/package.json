{
  "name": "azolve-chat-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Native shells (Android + iOS) for AZOLVE CHAT",
  "scripts": {
    "sync": "cap sync",
    "copy": "cap copy",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "build:www": "cd ../web && VITE_DEMO=1 npx vite build --outDir dist-demo --base ./",
    "android:apk": "cd android && ./gradlew assembleDebug",
    "android:apk:live": "cd android && ./gradlew assembleDebug -PappUrl=$APP_URL"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/android": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}
